# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# Jupyter
.ipynb_checkpoints/

# Environment variables / secrets
.env
kaggle.json

# Project data (never commit dataset content, keep structure + docs)
data/retails/*
!data/retails/.gitkeep

data/external_video/videos/shoplifting/*
!data/external_video/videos/shoplifting/.gitkeep
data/external_video/videos/normal/*
!data/external_video/videos/normal/.gitkeep
data/external_video/frames/shoplifting/*
!data/external_video/frames/shoplifting/.gitkeep
data/external_video/frames/normal/*
!data/external_video/frames/normal/.gitkeep

# Outputs: checkpoints, logs, plots, demo videos (never commit, keep structure)
outputs/*
!outputs/.gitkeep
!outputs/checkpoints/
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
!outputs/logs/
outputs/logs/*
!outputs/logs/.gitkeep
!outputs/plots/
outputs/plots/*
!outputs/plots/.gitkeep

# A top-level checkpoints/ dir, if anything ever writes one outside
# outputs/checkpoints/. Anchored to the repo root so it doesn't also
# match (and reignore the .gitkeep in) outputs/checkpoints/ above.
/checkpoints/

# Model weights and pretrained checkpoints - never commit these
*.pt
*.pth
*.bin
*.onnx
*.npz

# Third-party code, cloned locally per README.md setup instructions -
# never vendored into this repo (large; has its own git history/license).
third_party/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
